# Copy to .env and fill in ONE provider key. Never commit the real file.
# The agent picks the provider from whichever key is set.

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
#   default model: claude-opus-5
#   cheaper, still capable for daily use:  PARADOX_MODEL=claude-sonnet-5

# --- OpenAI -------------------------------------------------------------- 
#   needs:  pip install -e ".[openai]"
# OPENAI_API_KEY=sk-...
#   default model: gpt-5   (override with PARADOX_MODEL)

# --- Google (Gemini) ---------------------------------------------------- 
#   needs:  pip install -e ".[google]"
# GEMINI_API_KEY=...
#   default model: gemini-3.6-flash
#   newest:  PARADOX_MODEL=gemini-3.8-flash
#   cheapest:  PARADOX_MODEL=gemini-3.5-flash-lite

# --- Optional overrides ------------------------------------------------- 
# PARADOX_PROVIDER=anthropic   # force one when several keys are present
# PARADOX_MODEL=...            # any model id the chosen provider serves
# PARADOX_EFFORT=high          # high | medium | low  (Anthropic only)
# PARADOX_GEMINI_THINKING=low  # minimal | low | medium | high  (Gemini only)
#   Gemini 3 thinks before every turn; 'low' keeps agent steps quick.
