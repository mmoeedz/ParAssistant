# Copy to .env and fill in ONE provider key. Never commit the real file.
# The agent picks the provider from whichever key is set.

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
#   default model: claude-opus-5
#   cheaper, still capable for daily use:  PARADOX_MODEL=claude-sonnet-5

# --- OpenAI -------------------------------------------------------------- 
#   needs:  pip install -e ".[openai]"
# OPENAI_API_KEY=sk-...
#   default model: gpt-5   (override with PARADOX_MODEL)

# --- Google (Gemini) ---------------------------------------------------- 
#   needs:  pip install -e ".[google]"
# GEMINI_API_KEY=...
#   default model: gemini-3.6-flash
#   newest:  PARADOX_MODEL=gemini-3.8-flash
#   cheapest:  PARADOX_MODEL=gemini-3.5-flash-lite

# --- Optional overrides -------------------------------------------------
# PARADOX_PROVIDER=anthropic   # force one when several keys are present
# PARADOX_MODEL=...            # any model id the chosen provider serves
# PARADOX_EFFORT=high          # high | medium | low  (Anthropic only)
# PARADOX_GEMINI_THINKING=low  # minimal | low | medium | high  (Gemini only)
#   Gemini 3 thinks before every turn; 'low' keeps agent steps quick.

# --- Google Cloud (Speech-to-Text + Text-to-Speech) ----------------------
#   NOT the same product/key as GEMINI_API_KEY above. Needs a Google Cloud
#   project with the "Cloud Speech-to-Text API" and "Cloud Text-to-Speech
#   API" enabled and billing on, then an API key restricted to those APIs —
#   console.cloud.google.com → APIs & Services → Credentials.
# GOOGLE_CLOUD_API_KEY=...
#   Alternative: a service-account JSON key's path, instead of the key above.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# PARADOX_STT_LANGUAGE=en-US      # default; any BCP-47 code Google STT serves
# PARADOX_STT_MODEL=latest_long   # default; latest_short suits short commands
# PARADOX_TTS=google              # default; sapi (local) or edge are fallbacks
# PARADOX_TTS_VOICE=en-US-Neural2-C  # default; any name from Google's voice list
