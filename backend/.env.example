# Copy to .env and fill in ONE provider key. Never commit the real file.
# The agent picks the provider from whichever key is set.

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
#   default model: claude-opus-5
#   cheaper, still capable for daily use:  PARADOX_MODEL=claude-sonnet-5

# --- OpenAI -------------------------------------------------------------- 
#   needs:  pip install -e ".[openai]"
# OPENAI_API_KEY=sk-...
#   default model: gpt-5   (override with PARADOX_MODEL)

# --- Google (Gemini) ---------------------------------------------------- 
#   needs:  pip install -e ".[google]"
# GEMINI_API_KEY=...
#   default model: gemini-3.6-flash
#   newest:  PARADOX_MODEL=gemini-3.8-flash
#   cheapest:  PARADOX_MODEL=gemini-3.5-flash-lite

# --- Optional overrides -------------------------------------------------
# PARADOX_PROVIDER=anthropic   # force one when several keys are present
# PARADOX_MODEL=...            # any model id the chosen provider serves
# PARADOX_EFFORT=high          # high | medium | low  (Anthropic only)
# PARADOX_GEMINI_THINKING=low  # minimal | low | medium | high  (Gemini only)
#   Gemini 3 thinks before every turn; 'low' keeps agent steps quick.

# --- Voice ---------------------------------------------------------------
#   Works out of the box with no extra keys:
#   * speech to text — uses GEMINI_API_KEY (above) when Google Cloud below is
#     not set: each utterance is sent to Gemini once you stop talking.
#   * text to speech — Microsoft Edge's neural voices (pip install -e ".[edge]"),
#     then the built-in Windows voices if the network is down.
# PARADOX_STT=gemini                          # force one: gemini | google
# PARADOX_STT_GEMINI_MODEL=gemini-3.5-flash-lite   # default; fast and cheap
# PARADOX_STT_GEMINI_FALLBACK=gemini-3.6-flash     # tried when the first is busy
# PARADOX_TTS_EDGE_VOICE=en-GB-SoniaNeural    # default Edge voice; e.g. ur-PK-UzmaNeural

# --- Google Cloud (Speech-to-Text + Text-to-Speech) ----------------------
#   Optional upgrade: streaming recognition (text is ready the moment you
#   stop) and Google's voices. Takes priority over the defaults above when set.
#   NOT the same product/key as GEMINI_API_KEY above. Needs a Google Cloud
#   project with the "Cloud Speech-to-Text API" and "Cloud Text-to-Speech
#   API" enabled and billing on, then an API key restricted to those APIs —
#   console.cloud.google.com → APIs & Services → Credentials.
# GOOGLE_CLOUD_API_KEY=...
#   Alternative: a service-account JSON key's path, instead of the key above.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# PARADOX_STT_LANGUAGE=en-US      # default; any BCP-47 code Google STT serves
# PARADOX_STT_MODEL=latest_long   # default; latest_short suits short commands
# PARADOX_TTS=google              # tried first; edge, then sapi (local), if it cannot speak
# PARADOX_TTS_VOICE=en-US-Neural2-C  # default; any name from Google's voice list

# --- WhatsApp Cloud API (official, Meta) ---------------------------------
#   A different capability from Luna's existing whatsapp_send — that one
#   drives the WhatsApp Desktop app as your own personal account; this one
#   sends from a WhatsApp Business number registered to a Meta developer
#   app. It cannot act as your personal number — Meta's API has no concept
#   of that. Free to use for testing, no business verification needed, as
#   long as recipients are pre-added as test numbers (see below).
#
#   Setup (free tier, ~5 minutes):
#   1. developers.facebook.com → Create App → type "Business" → add the
#      "WhatsApp" product.
#   2. Its WhatsApp > API Setup page gives you, immediately, for free:
#        - a temporary access token (valid 24h — fine for testing; for a
#          token that does not expire, add a System User under Business
#          Settings and generate one there instead)
#        - a "Phone number ID" for the free test number Meta assigns you
#   3. On that same page, "To" field: add up to 5 phone numbers (yours,
#      family, whoever) — each must accept a verification code Meta texts
#      them once. Only these numbers can receive messages until the
#      WhatsApp Business Account is verified for production.
#   4. Paste the token and phone number id below.
#
#   Real limits, not a bug in this code: a plain text message
#   (whatsapp_api_send) only delivers if the recipient messaged this
#   business number in the last 24 hours, or is one of the 5 test numbers
#   above. Anyone else — or anyone outside that window — needs a
#   pre-approved message template instead (whatsapp_api_send_template),
#   created in the Meta Business dashboard.
# WHATSAPP_API_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0   # default; bump when Meta deprecates an older one
